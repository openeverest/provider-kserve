# Predictor topology definition.
#
# DISABLED: this file is intentionally named `topology.yaml.disabled` so the
# definition assembler skips it, hiding the `predictor` topology from the UI
# topology list. The predictor code (types.go, internal/provider, tests) is kept
# for later. To re-enable, rename this file back to `topology.yaml` and run
# `make generate`.
#
# Wraps KServe InferenceService (serving.kserve.io/v1beta1) for general
# predictive model serving (sklearn, pytorch, tensorflow, xgboost, onnx,
# triton, huggingface, ...). KServe auto-selects a ServingRuntime from the
# declared model format.
#
# config.components: Which components are used and their defaults.
# config.parametersSchema: Reference a Go type for topology parameters.
# ui: Rendering hints for the frontend form.
#
# See github.com/openeverest/provider-sdk/blob/main/PROVIDER_DEVELOPMENT.md
# for detailed guidance.
config:
  parametersSchema: PredictorTopologyParameters
  components:
    predictor:
      defaults:
        replicas: 1
ui:
  sections:
    basicInfo:
      label: Basic Information
      description: Configure the model to serve.
      components:
        version:
          uiType: select
          path: spec.components.predictor.version
          fieldParams:
            label: KServe Version
        modelFormat:
          uiType: text
          path: spec.components.predictor.parameters.modelFormat
          fieldParams:
            label: Model Format
            placeholder: sklearn
          validation:
            required: true
        storageURI:
          uiType: text
          path: spec.components.predictor.parameters.storageURI
          fieldParams:
            label: Model Storage URI
            placeholder: gs://kfserving-examples/models/sklearn/1.0/model
          validation:
            required: true
        runtimeVersion:
          uiType: text
          path: spec.components.predictor.parameters.runtimeVersion
          fieldParams:
            label: Runtime Version
        runtime:
          uiType: text
          path: spec.components.predictor.parameters.runtime
          fieldParams:
            label: Serving runtime
            placeholder: kserve-sklearnserver
        nodeSelector:
          uiType: keyValue
          path: spec.components.predictor.parameters.nodeSelector
          fieldParams:
            label: Node selector
        # env, args, and tolerations are YAML-only: the form generator has no
        # list-of-object control that matches []EnvVar / []string / []Toleration.
      componentsOrder:
      - version
      - modelFormat
      - storageURI
      - runtime
      - runtimeVersion
      - nodeSelector
    scaling:
      label: Scaling
      description: Configure autoscaling bounds for the predictor.
      components:
        minReplicas:
          uiType: number
          path: spec.components.predictor.parameters.minReplicas
          fieldParams:
            label: Min Replicas
          validation:
            min: 0
            max: 32
        maxReplicas:
          uiType: number
          path: spec.components.predictor.parameters.maxReplicas
          fieldParams:
            label: Max Replicas
          validation:
            min: 0
            max: 32
      componentsOrder:
      - minReplicas
      - maxReplicas
    routing:
      label: Routing
      description: How clients reach this model. ClusterIP stays in-cluster; LoadBalancer and NodePort create a provider-owned Service in front of the predictor pods.
      components:
        externalAccess:
          uiType: select
          path: spec.topology.parameters.externalAccess
          fieldParams:
            label: External access
            options:
            - label: ClusterIP
              value: ClusterIP
            - label: LoadBalancer
              value: LoadBalancer
            - label: NodePort
              value: NodePort
      componentsOrder:
      - externalAccess
  sectionsOrder:
  - basicInfo
  - scaling
  - routing
