# Environment configuration for the provider dev Tiltfile (dev/Tiltfile).
#
# Copy this file to dev/.env and adjust as needed:
#   cp dev/.env.example dev/.env

# -- OpenEverest core --------------------------------------------------------

# Install the latest released OpenEverest v2 core (server + controller + CRDs)
# from the published Helm repository. Set to false if you run the core from
# source in a separate Tilt instance (see dev/README.md).
INSTALL_OPENEVEREST=true

# OpenEverest core chart version to install. Leave empty for the latest stable
# release.
# NOTE: while OpenEverest v2 is in pre-release, the Helm repository only
# publishes pre-release tags (e.g. 2.0.0-dev.1). Helm's "latest" resolution
# skips pre-releases, so you must set this explicitly until v2.0.0 is generally
# available, e.g. OPENEVEREST_VERSION=2.0.0-dev.1
OPENEVEREST_VERSION=

# Helm repository that hosts the OpenEverest core chart.
OPENEVEREST_HELM_REPO=https://openeverest.github.io/helm-charts/

# Git ref used to refresh CRDs after the published chart install. The 2.0.0-dev.1
# chart lags the unified parametersSchema API (#2583); default release-2.0
# overlays those CRDs so Provider CRs with parametersSchema apply cleanly.
OPENEVEREST_BRANCH=release-2.0

# Namespace the OpenEverest core is installed into.
EVEREST_NAMESPACE=everest-system

# Initial admin password for the Everest UI/API.
UI_ADMIN_PASSWORD=admin

# -- Provider ----------------------------------------------------------------

# Namespace the provider and the bundled KServe controllers/configs deploy into.
# Any namespace works: the provider renders the KServe runtime-config presets
# (LLMInferenceServiceConfig) into the release namespace, which is where the
# llmisvc controller resolves them from.
PROVIDER_NAMESPACE=default

# Go build environment used to compile the provider binary.
PROVIDER_BUILD_ENV=CGO_ENABLED=0 GOOS=linux

# -- cert-manager ------------------------------------------------------------

# Install cert-manager (required by the KServe controllers for their webhook
# certificates). Installed as its own release for a reliable dev loop. Set to
# false when the cluster already runs cert-manager.
INSTALL_CERT_MANAGER=true

# cert-manager chart version to install.
CERT_MANAGER_VERSION=v1.16.2

# Whether to install Envoy AI Gateway and deploy the small CPU test Instance
# from dev/resources/ai-gateway-llm.yaml.
ENABLE_AI_GATEWAY=false

# -- Metrics / observability (optional) --------------------------------------

# Install kube-prometheus-stack (Prometheus + Grafana) and enable labeled
# dashboard ConfigMaps on the provider chart (metrics.grafanaDashboards). Grafana
# is port-forwarded to http://localhost:3000 (admin / prom-operator). The provider
# emits PodMonitors; kube-prom Prometheus scrapes them. With ENABLE_AI_GATEWAY=true,
# the gateway dashboard ConfigMap is included too.
ENABLE_METRICS=false

# -- Backups (optional) ------------------------------------------------------

# Deploy MinIO and a BackupStorage CR for testing backup/restore flows.
ENABLE_MINIO=false

# -- Cluster / registry (optional) -------------------------------------------

# Restrict Tilt to a specific Kubernetes context (recommended).
# K8S_CONTEXT=k3d-provider-kserve-test

# Push images to a specific registry (defaults to the cluster's local registry).
# DOCKER_REGISTRY_URL=
